<Window x:Class="FadeOut.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="fadeout" Width="370" Height="590" MinWidth="340" MinHeight="430"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" Icon="/Assets/FadeOut.png"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#13251C" />
        <SolidColorBrush x:Key="MutedInk" Color="#647269" />
        <SolidColorBrush x:Key="Forest" Color="#1B5038" />
        <SolidColorBrush x:Key="Track" Color="#CFDACB" />

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Forest}" />
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderBrush" Value="#241B5038" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#50FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Fader" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource Forest}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource Track}"
                                                        BorderBrush="#2A1B5038" BorderThickness="0.5" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="15" Height="15" CornerRadius="8" Background="#FAFBF3"
                                                        BorderBrush="#7D9980" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ForestCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MutedInk}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="4"
                                    Background="#30FFFFFF" BorderBrush="#661B5038" BorderThickness="1">
                                <Path x:Name="Tick" Data="M 3 7 L 6 10 L 12 3" Stroke="White"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Forest}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" BorderBrush="#301B5038" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F6F6E9" Offset="0" />
                <GradientStop Color="#E9F0DF" Offset="0.48" />
                <GradientStop Color="#DCE8D4" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid Margin="13">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,10" MouseLeftButtonDown="Header_Drag">
                <TextBlock Text="f a d e o u t" FontFamily="Segoe UI Variable Display"
                           FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Ink}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource QuietButton}" Padding="7,3" Content="—"
                            FontSize="12" Click="Minimize_Click" ToolTip="Hide" />
                    <Button Style="{StaticResource QuietButton}" Padding="7,3" Margin="5,0,0,0"
                            Content="×" FontSize="12" Click="Hide_Click" ToolTip="Close to tray" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="3,0,3,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="master" Foreground="{StaticResource MutedInk}" FontSize="11"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Slider x:Name="MasterSlider" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100"
                        Style="{StaticResource Fader}" ValueChanged="MasterSlider_Changed" />
                <TextBlock x:Name="MasterLabel" Grid.Column="2" Foreground="{StaticResource Forest}"
                           FontSize="11" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="2" Background="#68FFFFFF" BorderBrush="#181B5038"
                    BorderThickness="1" CornerRadius="13" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="1,0,1,7">
                        <TextBlock Text="m i x e r" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedInk}" />
                        <TextBlock x:Name="ActiveLabel" HorizontalAlignment="Right" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource MutedInk}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MixerItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="27" Height="27" CornerRadius="7" Background="#28FFFFFF"
                                                BorderBrush="#181B5038" BorderThickness="1">
                                            <Image Source="{Binding Icon}" Width="22" Height="22" />
                                        </Border>
                                        <Grid Grid.Column="1" Margin="3,0,8,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding VolumeLabel}" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Forest}" FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <Slider Grid.Row="1" Minimum="0" Maximum="100" Margin="0,2,0,0"
                                                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource Fader}" />
                                        </Grid>
                                        <Button Grid.Column="2" Width="27" Height="27" Padding="0"
                                                Style="{StaticResource QuietButton}" Content="{Binding MuteGlyph}"
                                                Click="Mute_Click" ToolTip="Mute or unmute" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="quiet for now" HorizontalAlignment="Center" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Apps with an audio session appear here."
                                   Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource MutedInk}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="2,9,2,0">
                <StackPanel>
                    <TextBlock x:Name="DeviceLabel" FontSize="9.5" Foreground="{StaticResource MutedInk}"
                               TextTrimming="CharacterEllipsis" MaxWidth="215" HorizontalAlignment="Left" />
                    <CheckBox x:Name="StartupCheck" Content="launch at login" Margin="0,5,0,0"
                              Style="{StaticResource ForestCheck}" Checked="Startup_Changed" Unchecked="Startup_Changed" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource QuietButton}"
                        Content="power  quit" FontSize="10.5" Click="Quit_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
